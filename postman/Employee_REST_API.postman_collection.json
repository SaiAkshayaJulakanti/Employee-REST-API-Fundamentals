	"item": [
		{
			"name": "01 - Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"health"
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('System is healthy', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql('healthy');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "02 - Create Employee (POST)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"department\": \"Engineering\",\n    \"role\": \"Backend Engineer\",\n    \"salary\": 85000.0\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/employees",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"employees"
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test('Response contains created employee details', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql('success');",
							"    pm.expect(jsonData.data.name).to.eql('John Doe');",
							"    pm.expect(jsonData.data.email).to.eql('john.doe@example.com');",
							"    pm.collectionVariables.set('employeeId', jsonData.data.id);",
							"});",
							"pm.test('Response has Location header', function () {",
							"    pm.response.to.have.header('Location');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "03 - Get All Employees (GET)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/employees?page=1&per_page=10",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"employees"
					],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "per_page",
							"value": "10"
						}
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Response contains array of employees and pagination', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql('success');",
							"    pm.expect(jsonData.data).to.be.an('array');",
							"    pm.expect(jsonData).to.have.property('pagination');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "04 - Filter Employees by Department (GET)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/employees?department=Engineering",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"employees"
					],
					"query": [
						{
							"key": "department",
							"value": "Engineering"
						}
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Filtered results match department', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql('success');",
							"    jsonData.data.forEach(function(emp) {",
							"        pm.expect(emp.department).to.include('Engineering');",
							"    });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
